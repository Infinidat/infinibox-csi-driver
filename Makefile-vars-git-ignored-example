_GITLAB_USER=host-opensource
_IMAGE_TAG = v2.22.0
_IMAGE_NAMES = "infinidat-csi-driver infinidat-csi-metrics infinidat-csi-operator"

_TEST_ONE_THING_DIR=storage
_TEST_ONE_THING=TestISCSIControllerSuite/Test_CreateVolume_content_success

# location of test images, if not set, default is to use dockerhub as the registry
_E2E_TEST_IMAGE=infinidat/csitestimage:latest
_E2E_TEST_BLOCK_IMAGE=infinidat/csitestimageblock:latest
#_E2E_TEST_IMAGE=your-internal-registry/infinidat-csi-driver/csitestimage:latest
#_E2E_TEST_BLOCK_IMAGE=your-internal-registry/infinidat-csi-driver/csitestimageblock:latest

_E2E_NAMESPACE=infinidat-csi
_E2E_POOL=csitesting

_E2E_NAS_NETWORK_SPACE=default_nas_space
_E2E_ISCSI_NETWORK_SPACE=default_iscsi_space
_E2E_ISCSI_NETWORK_SPACE2=default_iscsi_space
_E2E_NVME_NETWORK_SPACE=default_nvme_space

# for replication testing
_E2E_IBOXREPLICA_CG=example-cg
_E2E_IBOXREPLICA_VOLUME=example-1234
_E2E_IBOXREPLICA_FILESYSTEM=example-filesystem-01
_E2E_IBOXREPLICA_REMOTE_POOL_ID=12345
_E2E_IBOXREPLICA_LINK_REMOTE_SYSTEM_NAME=some-ibox-01


_E2E_PROTOCOL=nfs
_E2E_IBOX_SECRET=infinibox-creds
_E2E_IBOX_SECRET2=
_E2E_K8S_VERSION=v1.30.1
_E2E_OCP_VERSION=v4.16
_E2E_IBOX_USERNAME=someusername
_E2E_IBOX_PASSWORD=somepassword
_E2E_IBOX_HOSTNAME=somehost
_E2E_USE_NFS_V4=false
_E2E_CLEANUP=true
_E2E_STRESS_ITERATIONS=2
_E2E_STRESS_SLEEP_SECONDS=10

# used for testing nfs ip ranges for export rule permissions
_E2E_NFS_EXPORT_PERMISSION="[{'access':'RW','client':'192.168.147.190-192.168.147.199','no_root_squash':true}]"
# used for testing nfs ip ranges for export rule permissions
#_E2E_NFS_EXPORT_PERMISSION="[{'access':'RW','client':'172.20.65.31-172.20.84.246','no_root_squash':true}]"
# this is for testing nfs ip ranges that are invalid
#_E2E_NFS_EXPORT_PERMISSION="[{'access':'RW','client':'192.168.147.190-192.168.147.199','no_root_squash':true}]"
# this is for testing nfs dual exports example
#_E2E_NFS_EXPORT_PERMISSION="[{'access':'RW','client':'172.20.65.31','no_root_squash':true},{'access':'RW','client':'172.20.84.246','no_root_squash':true}]"
#_E2E_NFS_EXPORT_PERMISSION="[{'access':'RW','client':'192.168.147.190-192.168.147.199','no_root_squash':true},{'access':'RW','client':'172.20.84.246','no_root_squash':true}]"

# comment out pull secret env var if running on openshift, use global pull secret instead
_E2E_IMAGE_PULL_SECRET=private-docker-reg-secret
_CLI=kubectl
_CLIN=$(_CLI) -n $(_E2E_NAMESPACE)
