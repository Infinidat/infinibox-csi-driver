##@ Developer Recipes
.PHONY: install-e2e-tools
DETECTED_KUBE_VERSION = $(shell kubectl version -o json | jq -r ' .serverVersion.gitVersion | split("+")[0]')
install-e2e-tools: ## install e2e related binaries
	echo $(DETECTED_KUBE_VERSION) is the kube version detected
ifeq (,$(wildcard ./$(DETECTED_KUBE_VERSION)-kubernetes-test-linux-amd64.tar.gz))
	echo "downloading the e2e test suite for $(DETECTED_KUBE_VERSION) ..."
	wget https://dl.k8s.io/$(DETECTED_KUBE_VERSION)/kubernetes-test-linux-amd64.tar.gz
	mv kubernetes-test-linux-amd64.tar.gz $(DETECTED_KUBE_VERSION)-kubernetes-test-linux-amd64.tar.gz
else
	echo "extracting the already downloaded e2e test suite for $(DETECTED_KUBE_VERSION) ..."
endif
	tar --strip-components=3 -zxf $(DETECTED_KUBE_VERSION)-kubernetes-test-linux-amd64.tar.gz \
		kubernetes/test/bin/e2e.test kubernetes/test/bin/ginkgo

